    <style>
      html{font-size:10px}.splash-screen{display:flex;justify-content:center;align-items:center;font-family:'Poppins',sans-serif;flex-direction:column;position:fixed;top:0;right:0;bottom:0;left:0;z-index:10000;background-color:hsl(214 16% 93.5%);will-change:opacity;transition-property:opacity;transition-duration:.34s;transition-timing-function:linear;padding:2rem}.splash-screen svg{position:absolute;width:7rem;height:7rem;will-change:transform;animation-name:x-fan-bounce;animation-duration:1.2s;animation-fill-mode:forwards;animation-direction:alternate;animation-iteration-count:infinite;animation-timing-function:cubic-bezier(0.4,0,0.6,1)}.splash-screen button{margin:1.2rem;border:none;border-radius:8px;color:#fff;padding:.9rem 2.2rem;font-size:1.5rem;line-height:1;background-color:#054fa3;}.splash-screen h3{font-weight:500;max-width:82%}.splash-screen__base{fill:#054fa3}.splash-screen__accent{fill:#2fc118}.splash-screen.hide{opacity:0}.splash-screen.hide svg>*{opacity:0;transform:scale(.3);transition-property:opacity,transform;transition-duration:.2s,.38s;transform-origin:center}@media (prefers-color-scheme:dark){.splash-screen{background-color:hsl(212 12% 4%);color:#fff}.splash-screen__base{fill:#054fa3}.splash-screen__accent{fill:#46e82e}}@keyframes x-fan-bounce{0%,2%{transform:translateY(-5rem) scaleX(1) scaleY(.95)}100%,20%{transform:translateY(0) scaleX(1) scaleY(1)}40%{transform:translateY(1.5rem) scaleX(1.15) scaleY(.8)}60%{transform:translateY(-.7rem) scaleX(.9) scaleY(1.05)}80%{transform:translateY(.2rem) scaleX(1.06) scaleY(.95)}}
    </style>
  <link rel="stylesheet" href="styles-6WQ2KTET.css"></head>
  <body>
    <app-root></app-root>
    <div class="splash-screen">
      <svg viewBox="0 0 87 89" version="1.1" space="preserve">
        <path class="splash-screen__accent" d="M45.69,27.975c5.241,0 10.179,-4.334 10.885,-9.575c0.706,-5.241 -3.024,-9.575 -8.265,-9.575c-5.241,0 -10.179,4.334 -10.885,9.575c-0.706,5.241 2.923,9.575 8.265,9.575Z"/>
        <path class="splash-screen__base" d="M26.7,2.4l0.2,-1.8l-14.4,0l-0.2,1.8c-2.7,19.4 4.5,31.7 11.1,38.6c7,7.4 14.8,10.3 15.2,10.4l0.2,0.1c25.6,8.2 21.5,33.9 21.3,35l-0.3,1.8l7.2,0.1l7.2,0l0.3,-1.8c0.3,-2.3 1.3,-10.5 -1.2,-19.9c-2.6,-9.9 -9.6,-23 -28.3,-29c-1.3,-0.5 -21.9,-9.1 -18.3,-35.3Z"/>
        <path class="splash-screen__base" d="M86.1,2.4l0.2,-1.8l-14.4,0l-0.2,1.8c-2,14.4 -9.6,23.5 -16.8,29c5,1.9 9.1,4.3 12.4,7.1c7.8,-7.3 16.4,-18.9 18.8,-36.1Z"/>
        <path class="splash-screen__base" d="M30.6,58.4c-0.3,-0.1 -5.7,-2.1 -11.5,-6.9c-4.7,4.4 -8.6,9.5 -11.7,15.2c-5,9.3 -6.4,17.6 -6.6,19.9l-0.2,1.8l14.4,0l0.2,-1.9c0.1,-0.7 1.9,-16.9 16.3,-27.8c-0.2,-0.1 -0.4,-0.1 -0.6,-0.2l-0.3,-0.1Z"/>
      </svg>
    </div>

    <!-- Detect Angular -->
    <script>
      // ========== DIAGNOSTIC SYSTEM FOR ANDROID APP ==========
      // Collects errors and storage info for debugging PWA init failures
      window.fxDiagnostics = {
        errors: [],
        stages: [],
        startTime: Date.now(),
        addStage: function(name) {
          this.stages.push(name + ': +' + (Date.now() - this.startTime) + 'ms');
        },
        addError: function(type, message, stack) {
          this.errors.push({
            type: type,
            message: (message || '').substring(0, 500),
            stack: (stack || '').substring(0, 1000),
            time: '+' + (Date.now() - this.startTime) + 'ms'
          });
          // Send to Android immediately if available
          if (window.Android && window.Android.reportDiagnostic) {
            window.Android.reportDiagnostic(JSON.stringify(this.errors[this.errors.length - 1]));
          }
        },
        getStorageInfo: async function() {
          var info = { localStorage: 'N/A', indexedDB: 'N/A', cacheStorage: 'N/A', quota: 'N/A' };
          try {
            // localStorage size estimate
            var lsSize = 0;
            for (var key in localStorage) {
              if (localStorage.hasOwnProperty(key)) {
                lsSize += (localStorage[key].length + key.length) * 2; // UTF-16
              }
            }
            info.localStorage = (lsSize / 1024).toFixed(1) + 'KB';
          } catch (e) { info.localStorage = 'Error: ' + e.message; }

          try {
            // IndexedDB databases and sizes
            if (indexedDB.databases) {
              var dbs = await indexedDB.databases();
              var dbInfo = [];
              for (var i = 0; i < dbs.length; i++) {
                dbInfo.push(dbs[i].name);
              }
              info.indexedDB = dbInfo.length + ' DBs: ' + dbInfo.join(', ');
            } else {
              info.indexedDB = 'databases() not supported';
            }
          } catch (e) { info.indexedDB = 'Error: ' + e.message; }

          try {
            // Cache Storage
            if (typeof caches !== 'undefined') {
              var keys = await caches.keys();
              info.cacheStorage = keys.length + ' caches: ' + keys.join(', ');
            }
          } catch (e) { info.cacheStorage = 'Error: ' + e.message; }

          try {
            // Storage quota estimate
            if (navigator.storage && navigator.storage.estimate) {
              var estimate = await navigator.storage.estimate();
              var usedMB = (estimate.usage / (1024 * 1024)).toFixed(1);
              var quotaMB = (estimate.quota / (1024 * 1024)).toFixed(0);
              var pct = ((estimate.usage / estimate.quota) * 100).toFixed(1);
              info.quota = usedMB + 'MB / ' + quotaMB + 'MB (' + pct + '%)';
            }
          } catch (e) { info.quota = 'Error: ' + e.message; }

          return info;
        },
        getSWInfo: async function() {
          var info = { state: 'N/A', scriptURL: 'N/A', updateFound: false };
          try {
            if ('serviceWorker' in navigator) {
              var reg = await navigator.serviceWorker.getRegistration();
              if (reg) {
                var sw = reg.active || reg.waiting || reg.installing;
                info.state = sw ? sw.state : 'no worker';
                info.scriptURL = sw ? sw.scriptURL.split('/').pop() : 'none';
                info.scope = reg.scope;
              } else {
                info.state = 'not registered';
              }
            } else {
              info.state = 'not supported';
            }
          } catch (e) { info.state = 'Error: ' + e.message; }
          return info;
        },
        getFullReport: async function() {
          var storage = await this.getStorageInfo();
          var sw = await this.getSWInfo();
          return {
            errors: this.errors,
            stages: this.stages,
            storage: storage,
            serviceWorker: sw,
            userAgent: navigator.userAgent,
            online: navigator.onLine,
            url: location.href
          };
        }
      };

      // Capture all JavaScript errors
      window.onerror = function(message, source, lineno, colno, error) {
        var stack = error && error.stack ? error.stack : (source + ':' + lineno + ':' + colno);
        window.fxDiagnostics.addError('JS Error', message, stack);
        return false; // Let error propagate
      };

      // Capture unhandled promise rejections
      window.addEventListener('unhandledrejection', function(event) {
        var message = event.reason ? (event.reason.message || String(event.reason)) : 'Unknown rejection';
        var stack = event.reason && event.reason.stack ? event.reason.stack : '';
        window.fxDiagnostics.addError('Promise Rejection', message, stack);
      });

      // Signal to Android app that WebView is alive (backup call)
      document.addEventListener('DOMContentLoaded', function() {
        window.fxDiagnostics.addStage('DOMContentLoaded');
        if (window.Android && window.Android.webViewAlive) {
          window.Android.webViewAlive();
        }
      });

      window.addEventListener('load', () => {
        window.fxDiagnostics.addStage('windowLoad');

        // Skip error handling in dev mode (Vite dev server has timing issues)
        if (location.port === '4200') return;

        // Backup call to onDomReady in case Angular's call didn't fire
        if (window.Android && window.Android.onDomReady) {
          window.Android.onDomReady();
        }

        try {
          if (window.fxLoaded) {
            localStorage.removeItem('ng-load-failed');
          } else {
            if (localStorage.getItem('ng-load-failed')) {
              localStorage.removeItem('ng-load-failed');
              showFxError("<h2>Hmm... something's not loading</h2><h3>A connection issue is preventing the page from loading. Please check your internet and try again. If the issue persists, please contact us [support@fantrax.net].</h3>");
            } else {
              localStorage.setItem('ng-load-failed', '1');
              unregisterServiceWorkerAndReload();
            }
          }
        } catch (err) {
          showFxError("We cannot load the page because you are blocking cookies. <br> Please allow cookies for Fantrax.com and reload the page. <br>If you are still experiencing the same issue, please contact support@fantrax.com.")
        }
      });
      function showFxError(msg) {
        const splash = document.querySelector('.splash-screen');
        const button = document.createElement('button');
        button.onclick = unregisterServiceWorkerAndReload;
        button.innerHTML = 'Reload';
        splash.innerHTML = msg;
        splash.appendChild(button);
      }
      function unregisterServiceWorkerAndReload() {
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.getRegistrations().then((registrations) => {
            Promise.all(registrations.map((registration) => registration.unregister())).then(() => clearCacheAndReload());
          });
        } else {
          clearCacheAndReload();
        }
      }
      function clearCacheAndReload() {
        if (typeof caches !== 'undefined') {
          caches
            .keys()
            .then((keyList) => Promise.all(keyList.map((key) => caches.delete(key))).then(() => location.reload(true)));
        } else {
          location.reload(true);
        }
      }
      // Google Analytics
      window.global = window;
      window.ga =
        window.ga ||
        function () {
          (ga.q = ga.q || []).push(arguments);
        };
      ga.l = +new Date();
      ga('create', 'UA-5393701-1', 'auto');
    </script>
